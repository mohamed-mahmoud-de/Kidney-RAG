# Copy this file to .env and fill in the keys you have.
# .env is gitignored and never leaves your machine.
#
# The LLMPool auto-discovers all keys and load-balances between them.
# Add as many as you want per provider — round-robin across keys within
# the same provider, failover across providers.

# --- Gemini (primary tier — generation gets Gemini first) -----------------
GOOGLE_API_KEY=your-first-gemini-key
GOOGLE_API_KEY_2=your-second-gemini-key
# GOOGLE_API_KEY_3=optional-third

# --- HuggingFace (verification tier — safety checks stay off Gemini quota) -
HF_TOKEN=your-first-hf-token
HF_TOKEN_2=your-second-hf-token

# --- Anthropic (optional fallback tier) -----------------------------------
# ANTHROPIC_API_KEY=your-anthropic-key

# --- Model overrides (optional) -------------------------------------------
# KIDNEY_RAG_GEMINI_MODEL=gemini-3.6-flash
# KIDNEY_RAG_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# KIDNEY_RAG_ANTHROPIC_MODEL=claude-sonnet-5

# --- Pool tier order (optional) ------------------------------------------
# Priority for generation (verification uses HF-first regardless).
# LLM_POOL_ORDER=gemini,huggingface,anthropic
