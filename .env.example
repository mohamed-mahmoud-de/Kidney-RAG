# Copy this file to .env and fill in the keys you have.
# .env is gitignored and never leaves your machine.
#
# The LLMPool auto-discovers all keys and load-balances between them.
# Add as many as you want per provider — round-robin across keys within
# the same provider, failover across providers.

# --- Groq (primary tier — best free limits: 30 rpm / 14,400 req/day) -----
# Sign up: https://console.groq.com/  ->  API Keys  ->  Create API Key
GROQ_API_KEY=gsk_your_key_here
# GROQ_API_KEY_2=optional-second

# --- Gemini (fallback tier) -----------------------------------------------
GOOGLE_API_KEY=your-first-gemini-key
GOOGLE_API_KEY_2=your-second-gemini-key
# GOOGLE_API_KEY_3=optional-third

# --- HuggingFace (fallback tier) ------------------------------------------
HF_TOKEN=your-first-hf-token
HF_TOKEN_2=your-second-hf-token

# --- Anthropic (optional last-resort tier) --------------------------------
# ANTHROPIC_API_KEY=your-anthropic-key

# --- Model overrides (optional) -------------------------------------------
# KIDNEY_RAG_GROQ_MODEL=openai/gpt-oss-20b       # default
# KIDNEY_RAG_GROQ_MODEL=openai/gpt-oss-120b      # larger, slower, higher quality
# KIDNEY_RAG_GROQ_MODEL=qwen/qwen3.6-27b         # alternative
# KIDNEY_RAG_GEMINI_MODEL=gemini-3.6-flash
# KIDNEY_RAG_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# KIDNEY_RAG_ANTHROPIC_MODEL=claude-sonnet-5

# --- Pool tier order (optional) ------------------------------------------
# Default: groq,gemini,huggingface,anthropic  (best free tier first)
# LLM_POOL_ORDER=groq,gemini,huggingface,anthropic
